# Datenbank (Prisma) – benötigt eine laufende PostgreSQL-Instanz
# Lokal ohne Docker: von dir selbst befüllter Connection-String.
# Mit Docker Compose: wird automatisch aus POSTGRES_USER/POSTGRES_PASSWORD/
# POSTGRES_DB zusammengesetzt (siehe docker-compose.yml) – diese Zeile wird
# dann ignoriert, du musst sie nicht anpassen.
DATABASE_URL="postgresql://user:password@localhost:5432/project_atlas?schema=public"

# Nur für Docker Compose relevant (siehe docker-compose.yml, Service
# "postgres" sowie die daraus abgeleitete DATABASE_URL für "app"). Bei
# lokaler Entwicklung ohne Docker ohne Wirkung. Passwort möglichst ohne
# Sonderzeichen wie @ : / (werden nicht URL-kodiert, siehe DATABASE_URL-
# Zusammensetzung in docker-compose.yml).
POSTGRES_USER="atlas"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="project_atlas"

# Better Auth
# Secret generieren mit: openssl rand -base64 32
BETTER_AUTH_SECRET="changeme-32-characters-minimum"
BETTER_AUTH_URL="http://localhost:3000"
# Dient gleichzeitig als öffentliche Basis-URL der App (Stripe
# Success-/Cancel-URLs, robots.txt, sitemap.xml – siehe app/robots.ts) –
# in Produktion auf die tatsächliche Domain setzen (z. B. https://example.com).
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Stripe (Checkout + Webhook, siehe services/stripe/ und app/api/stripe/webhook)
# Test-Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_changeme"
# Webhook-Signing-Secret: https://dashboard.stripe.com/test/webhooks (oder `stripe listen` lokal)
STRIPE_WEBHOOK_SECRET="whsec_changeme"

# Echtzeit-WebSocket-Server (Foundation, npm run realtime) – optional, Default 3001
REALTIME_PORT="3001"

# Background Jobs & Queue (Foundation, npm run jobs:worker) – benötigt eine laufende Redis-Instanz
REDIS_URL="redis://localhost:6379"
# Worker-Concurrency – optional, Default 5
JOBS_WORKER_CONCURRENCY="5"

# Scheduler-Foundation (npm run scheduler) – Default false, noch keine echten Cronjobs
SCHEDULER_ENABLED="false"

# One-Piece-Katalogimport (npm run import:onepiece, siehe services/import/OnePieceImporter.ts)
# Kostenloser Key: https://apitcg.com/platform – für alle anderen Spiele nicht nötig,
# da deren APIs (Pokémon/Yu-Gi-Oh!/Magic/Lorcana) schlüssellos nutzbar sind.
ONE_PIECE_API_KEY="changeme"

# Nur für Docker Compose / nginx relevant (siehe docker-compose.yml,
# nginx/templates/app.conf.template). Die tatsächliche Domain, unter der
# der Server erreichbar ist bzw. sein wird (für lokale Tests z. B.
# "localhost" möglich – dann bleibt es beim selbstsignierten Platzhalter-
# Zertifikat, siehe README "HTTPS"). Muss mit NEXT_PUBLIC_BETTER_AUTH_URL
# oben übereinstimmen (dort inkl. https://, hier nur der reine Hostname).
DOMAIN="example.com"
# E-Mail-Adresse für Let's-Encrypt-Ablaufbenachrichtigungen (certbot
# --email, siehe README "HTTPS") – kein technischer Zwang, aber von
# Let's Encrypt empfohlen.
CERTBOT_EMAIL="admin@example.com"
